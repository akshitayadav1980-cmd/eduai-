# ─── VidyaVani — Environment Configuration Example ───────────────────────────
# Copy this file to .env and fill in the values for your environment.
# NEVER commit .env to version control.

# ─── API Base URLs ────────────────────────────────────────────────────────────

# Production FastAPI backend origin (no trailing slash).
# Set this in Netlify → Site settings → Environment variables.
# Leave unset in local development; the Vite dev proxy handles /api/* routing.
# Example: VITE_API_URL=https://eduai-swe0.onrender.com
VITE_API_URL=

# FastAPI backend base URL (legacy reference; used by apiClient.ts via VITE_API_URL above)
VITE_API_BASE_URL=http://localhost:8000

# ─── Translation Service ──────────────────────────────────────────────────────
# IndicTrans2 or equivalent translation endpoint (served via FastAPI)
VITE_TRANSLATION_API_URL=http://localhost:8000/api/translate

# ─── Speech / STT / TTS ──────────────────────────────────────────────────────
# Whisper-based STT endpoint
VITE_STT_API_URL=http://localhost:8000/api/stt

# ─── RAG / Content Retrieval ─────────────────────────────────────────────────
VITE_RAG_API_URL=http://localhost:8000/api/rag

# ─── OCR ─────────────────────────────────────────────────────────────────────
VITE_OCR_API_URL=http://localhost:8000/api/ocr

# ─── Feature Flags ────────────────────────────────────────────────────────────
VITE_ENABLE_3D_ASSISTANT=true
VITE_ENABLE_REAL_TIME_TRANSLATION=false
