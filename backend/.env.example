# ── Vernacular AI Backend — Environment Variables ────────────────────────────
#
# Copy this file to .env and fill in the values for your environment.
#
#   cp .env.example .env
#
# NEVER commit .env to version control — it is listed in .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────────────────────
APP_TITLE=Vernacular AI Backend
APP_VERSION=1.0.0
DEBUG=true

# ── Server ────────────────────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=8000

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string for the main vernacular_ai database.
# Replace YOUR_PASSWORD with your local PostgreSQL password.
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@localhost:5432/vernacular_ai

# ── Authentication ────────────────────────────────────────────────────────────
# Generate a strong secret key:
#   python -c "import secrets; print(secrets.token_hex(32))"
# REQUIRED for /auth/login and any protected endpoint.
# JWT_SECRET_KEY=replace-with-a-long-random-hex-string
# JWT_ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── AI / LLM ──────────────────────────────────────────────────────────────────
# Groq API key — required for AI fallback translation (free tier available).
# Get yours at: https://console.groq.com/
# GROQ_API_KEY=your_groq_api_key_here
# LLM_MODEL=llama-3.3-70b-versatile

# ── Translation service (future step) ────────────────────────────────────────
# TRANSLATION_API_URL=http://localhost:8001/translate

# ── Voice / STT / TTS (future step) ──────────────────────────────────────────
# STT_API_URL=http://localhost:8002/stt
# TTS_API_URL=http://localhost:8002/tts

# ── RAG / Vector store (future step) ─────────────────────────────────────────
# VECTOR_DB_URL=http://localhost:6333
# EMBEDDING_MODEL=text-embedding-3-small
